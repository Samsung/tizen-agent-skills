{
  "name": "tizen-sdk-skills-repo",
  "version": "1.6.1",
  "private": true,
  "description": "Repo-level lint/format tooling. The real packages (tests/, tizen-cli, vscode) stay independent.",
  "license": "Apache-2.0",
  "author": "Samsung Electronics",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samsung/tizen-agent-skills.git",
    "directory": "tizen-sdk-skills"
  },
  "bugs": {
    "url": "https://github.com/Samsung/tizen-agent-skills/issues"
  },
  "homepage": "https://github.com/Samsung/tizen-agent-skills/tree/main/tizen-sdk-skills",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts}\" \"CHANGELOG*.md\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts}\" \"CHANGELOG*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0"
  }
}
