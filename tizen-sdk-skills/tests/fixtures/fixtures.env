# Values for ${NAME} placeholders in TC argv (see runner.mjs).
# Single source for fixture parameters so they never appear on command
# lines inside TC YAMLs, where credential scanners flag them.
#
# Keys ending in _B64 are base64-decoded by the runner and exposed
# without the suffix (NAME_B64 → ${NAME}). This is not encryption —
# these values are intentionally non-secret — it only keeps
# credential-shaped literals out of the repo so security scanners stop
# re-flagging them.
#
# FIXTURE_CERT_UNLOCK unlocks fixtures/certs/test-fixture-author.p12 —
# a committed, throwaway, self-signed test certificate with no security
# value (it is not a real signing identity). Decode with:
#   base64 -d <<< UGFzc3cwcmQx
# Override via the environment if you regenerate the fixture.
FIXTURE_CERT_UNLOCK_B64=UGFzc3cwcmQx

# TC_CUSTOM_REPO_URL is the --repo-url used by the custom-repository install
# TCs (tc/sdk/sdk-install-custom-repo.*.yaml, sdk-install.custom-repo.yaml).
# The repository must serve pkg_list_{OS}-64, otherwise validation fails
# before the install path is exercised. The default is the public Tizen Studio
# repository; export TC_CUSTOM_REPO_URL to run the TCs against your own mirror.
TC_CUSTOM_REPO_URL=https://download.tizen.org/sdk/tizenstudio/official

# Device-tier fixtures (tc/device, tc/debug, tc/test). The values below only
# document the SHAPE and keep `scripts/runner-helpers.test.mjs` ("every
# ${NAME} resolves") honest; they are relative to tests/ and do not exist in
# a fresh checkout. `scripts/prepare-device-fixtures.mjs` builds the real
# apps under fixtures/apps/ (gitignored) and writes the absolute values to
# fixtures/apps/fixtures.generated.env, which scripts/run-device-tier.mjs
# merges into the runner's environment (process.env overrides this file).
FIXTURE_TMP_DIR=fixtures/apps/tmp
FIXTURE_NATIVE_TPK=fixtures/apps/MyNativeApp/Debug/org.example.mynativeapp-1.0.0-x86_64.tpk
FIXTURE_NATIVE_BIN=fixtures/apps/MyNativeApp/Debug/tpk/bin/mynativeapp
FIXTURE_NATIVE_APP_ID=org.example.mynativeapp
FIXTURE_DOTNET_APP_ID=org.tizen.example.MyDotNetApp
FIXTURE_WEB_APP_ID=XXXXXXXXXX.MyWebApp01
# Mutating tier (tc/project): scratch parent dir for create-project /
# build-project / project-delete, emptied by scripts/run-mutating-tier.mjs.
FIXTURE_PROJECTS_DIR=fixtures/apps/projects
