{
  "name": "tizen-sdk-skills-test-suite",
  "version": "1.3.1",
  "description": "Self-contained test suite for tizen-sdk plugin commands",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node runner.mjs",
    "lint": "node runner.mjs --dry-run && node scripts/verify-doc-stats.mjs && node scripts/runner-helpers.test.mjs",
    "test:safe": "node runner.mjs --tier=safe",
    "test:mutating": "node scripts/run-mutating-tier.mjs",
    "test:device": "node scripts/run-device-tier.mjs",
    "prepare:device": "node scripts/prepare-device-fixtures.mjs",
    "prepare:mutating": "node scripts/prepare-device-fixtures.mjs --only=tmp,projects"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.5.0"
  }
}
