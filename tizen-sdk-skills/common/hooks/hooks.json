{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-tizen-commands.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-project-writes.sh\""
          }
        ]
      },
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-skill-routing.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-update.js\" --host claude --cache-root \"${CLAUDE_PLUGIN_ROOT}/../..\""
          }
        ]
      }
    ]
  }
}
