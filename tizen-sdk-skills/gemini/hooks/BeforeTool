#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Samsung Electronics Co., Ltd.

# Gemini CLI BeforeTool hook — tizen-sdk-skills guard adapter.
# marker: tizen-sdk-skills (setup uses this to detect its own install)
#
# Bridges Gemini CLI's hook protocol to the shared guard scripts installed next
# to this file (check-tizen-commands.sh, check-project-writes.sh), so every
# harness enforces the same rules from ONE source.
#
#   Gemini stdin : {"hook_event_name":"BeforeTool","tool_name":"run_shell_command",
#                   "tool_input":{"command":"..."}, ...}
#   Guard stdin  : {"tool_name":"Bash","tool_input":{"command":"..."}}
#   Guard stdout : {"hookSpecificOutput":{"permissionDecision":"deny","permissionDecisionReason":"..."}}
#   Gemini stdout: {"decision":"deny","reason":"..."} to block; nothing (exit 0) to allow.
#
# Gemini's stdin already carries tool_name + tool_input, so this only renames
# the tool (run_shell_command -> Bash, write_file/replace -> Write) and converts
# the deny JSON. Exit code is always 0; deny is signalled via JSON.
#
# Installed by common/setup (hosts/gemini.sh) to ~/.gemini/hooks/tizen-sdk-skills/
# and referenced from ~/.gemini/settings.json:
#   hooks.BeforeTool[{ matcher: "run_shell_command|write_file|replace",
#                      hooks: [{ type: "command", command: "bash \"<this file>\"" }] }]

input="$(cat)"
guard_dir="$(cd "$(dirname "$0")" && pwd)"

allow() { exit 0; }

# Raw JSON-escaped string value for a key (keeps \\ and \" pairs intact — the
# guard rules depend on the escaped encoding).
json_val() {
  printf '%s' "$1" | sed -nE 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"((\\.|[^"\\])*)".*/\1/p'
}

# Same, but for the FIRST occurrence of the key. Inside a JSON string every
# quote is escaped (\"), so an unescaped "key" can only be a structural key —
# the first hit is the tool parameter no matter where "content"/"old_string"
# sit or what the file body contains. (json_val's greedy .* takes the LAST
# match, which a body containing the key name could hijack.)
json_first() {
  rest="${1#*\"$2\"}"
  [ "$rest" = "$1" ] && return 0
  printf '%s' "$rest" | sed -nE 's/^[[:space:]]*:[[:space:]]*"((\\.|[^"\\])*)".*/\1/p'
}

tool="$(json_val "$input" tool_name)"

case "$tool" in
  run_shell_command)
    cmd="$(json_val "$input" command)"
    [ -n "$cmd" ] || allow
    payload='{"tool_name":"Bash","tool_input":{"command":"'"$cmd"'"}}'
    ;;
  write_file|replace)
    # First structural "file_path" key — see json_first. (The previous approach
    # cut the payload at "content"/"old_string" first; when the model emitted
    # the body BEFORE the path, the path was cut away and the write slipped
    # through.)
    # Scope the search to tool_input: a structural "file_path" key elsewhere in
    # the hook payload (host metadata before "tool_input") must not be
    # mistaken for the write target.
    scope="${input#*\"tool_input\"}"
    [ "$scope" = "$input" ] && scope="$input"
    fp="$(json_first "$scope" file_path)"
    if [ -z "$fp" ]; then
      # A file write whose target we cannot determine is refused, not guessed.
      printf '{"decision":"deny","reason":"tizen-sdk-skills guard: could not determine the target path of %s - retry with an explicit file_path parameter."}\n' "$tool"
      exit 0
    fi
    payload='{"tool_name":"Write","tool_input":{"file_path":"'"$fp"'"}}'
    ;;
  *)
    allow
    ;;
esac

for guard in check-tizen-commands.sh check-project-writes.sh; do
  [ -f "$guard_dir/$guard" ] || continue
  out="$(printf '%s' "$payload" | bash "$guard_dir/$guard" 2>/dev/null)" || continue
  if printf '%s' "$out" | grep -q '"permissionDecision":"deny"'; then
    reason="$(printf '%s' "$out" | sed -nE 's/.*"permissionDecisionReason":"((\\.|[^"\\])*)".*/\1/p')"
    printf '{"decision":"deny","reason":"%s"}\n' "$reason"
    exit 0
  fi
done

allow
